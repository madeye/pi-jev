{
  "name": "pi-jev",
  "version": "0.1.0",
  "description": "Jev-assisted file retrieval and request caching for faster Pi workflows",
  "license": "MIT",
  "author": "Max Lv",
  "repository": "github:madeye/pi-jev",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "lint": "tsc --noEmit && biome check .",
    "format": "biome check --write .",
    "test": "tsx --test test/*.test.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "eval:speed": "tsx scripts/eval-speed.ts",
    "bench:local": "tsx scripts/bench-local.ts",
    "bench:retrieval": "tsx scripts/bench-retrieval.ts",
    "bench:tps": "tsx scripts/bench-tps.ts",
    "bench:coding": "tsx scripts/bench-coding.ts",
    "bench:cache": "tsx scripts/bench-cache.ts",
    "bench:direct": "tsx scripts/bench-direct.ts",
    "tune:focus": "tsx scripts/tune-focus.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0"
  },
  "dependencies": {
    "typebox": "1.3.7",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
